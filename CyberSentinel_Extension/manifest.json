{
    "manifest_version": 3,
    "name": "CyberSentinel",
    "version": "1.0",
    "permissions": [
        "activeTab",
        "scripting",
        "notifications",
        "tabs"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ]
}
